<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="{StaticResource Paper}">
    <ScrollView>
        <VerticalStackLayout Padding="20,26,20,35" Spacing="18">

            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="26">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="{StaticResource Gold}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 18"
                            WidthRequest="72" HeightRequest="72"
                            HorizontalOptions="Center">
                        <Label Text="H" FontSize="44" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="{StaticResource NavyDeep}" />
                    </Border>
                    <Label Text="HOTEL PRIME" FontSize="28" FontAttributes="Bold"
                           TextColor="White" HorizontalTextAlignment="Center" />
                    <Label Text="SOBRE O APLICATIVO" FontSize="12"
                           TextColor="{StaticResource Gold}" CharacterSpacing="1.8"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Versão 1.0  •  2026" FontSize="12"
                           TextColor="#D1DDE7" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="{StaticResource Outline}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Desenvolvimento" FontSize="19" FontAttributes="Bold"
                           TextColor="{StaticResource Navy}" />
                    <Label Text="DESENVOLVEDOR" FontSize="11" CharacterSpacing="1"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="Leonardo Nunes de Souza" FontSize="18"
                           FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Outline}" />
                    <Label Text="ANO DE DESENVOLVIMENTO" FontSize="11" CharacterSpacing="1"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="2026" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource Ink}" />
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Outline}" />
                    <Label Text="CURSO" FontSize="11" CharacterSpacing="1"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="Técnico em Desenvolvimento de Sistemas"
                           TextColor="{StaticResource Ink}" FontSize="15" />
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Outline}" />
                    <Label Text="DISCIPLINA / ATIVIDADE" FontSize="11" CharacterSpacing="1"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="Programação Mobile I • Agenda 13"
                           TextColor="{StaticResource Ink}" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="{StaticResource Outline}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sobre o projeto" FontSize="19" FontAttributes="Bold"
                           TextColor="{StaticResource Navy}" />
                    <Label Text="Aplicativo acadêmico de simulação de hospedagens. Permite escolher hóspedes, suíte e período de estadia e calcular automaticamente o valor estimado."
                           FontSize="14" TextColor="{StaticResource Ink}" />
                    <Label Text="Tecnologias: C#, XAML e .NET MAUI 10."
                           FontSize="13" TextColor="{StaticResource Muted}" />
                    <Label Text="Recursos: Image, Stepper, Picker, DatePicker, BindingContext e navegação entre telas."
                           FontSize="13" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="VOLTAR AO APP" Clicked="AoVoltar"
                    BackgroundColor="{StaticResource Gold}"
                    TextColor="{StaticResource NavyDeep}"
                    FontAttributes="Bold" CornerRadius="14" HeightRequest="52" />
            <Label Text="Projeto demonstrativo • Preços fictícios • 2026"
                   FontSize="11" TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
